# URL of the deployed backend API (client/server are separate Vercel
# projects, so this can't be a relative path in production).
# Local dev: http://localhost:5001/api
# Production: https://mern-stack-server.vercel.app/api
#
# Vite inlines this at BUILD time, not runtime — after changing it on
# Vercel (Settings > Environment Variables), you must trigger a new
# deployment for it to take effect.
VITE_API_BASE_URL=http://localhost:5001/api
